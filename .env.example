# DeepSeek API key - get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=your-api-key-here

# Model used for flashcards + grading (default: deepseek-flash — DeepSeek V4.1 Flash)
# DEEPSEEK_MODEL=deepseek-flash
# If the primary model id is rejected by the API, Buck retries once with this model.
# DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash-vision-exp

# Scanned/image PDFs are read via vision (V4.1 Flash multimodal) by default.
# Set to false to reject image PDFs instead of OCR-ing them.
# VISION_ENABLED=true

# Optional: Supabase for auth + quiz history + diagram image storage (see https://supabase.com)
# Diagram Labeling uploads images to the "diagrams" bucket; see supabase/README.md.
# Without Supabase, diagram images are compressed and stored with the card locally.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Optional: server port
# PORT=3000

# ---- Abuse protection (rate limits on the AI + scrape routes) ----
# Counters live in Upstash Redis when these are set — needed on Vercel, where each request may
# hit a different instance and in-memory counters barely limit anything. Free tier is plenty.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Requests allowed per window (default: one hour). Signed-in users are counted per account,
# everyone else (demo visitors) per IP address.
# RATE_WINDOW_SECONDS=3600
# RATE_AI_PER_USER=150
# RATE_AI_PER_IP=40
# RATE_SCRAPE_PER_USER=60
# RATE_SCRAPE_PER_IP=20

# Time budget for one AI request, in ms. Keep it under vercel.json's maxDuration (60s) so a
# slow answer ends in a clean "took too long" error instead of Vercel killing the function.
# AI_REQUEST_BUDGET_MS=50000

# Set to true to turn away anyone who isn't signed in (disables AI in demo mode).
# REQUIRE_LOGIN_FOR_AI=false

# Optional: unlocks the detailed view of /api/health?token=...
# HEALTH_TOKEN=some-long-random-string

# Set in production (Vercel sets it for you) to turn off verbose AI debug logs.
# NODE_ENV=production
