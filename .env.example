# DeepSeek API key - get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=your-api-key-here

# Model used for flashcards + grading (default: deepseek-flash — DeepSeek V4.1 Flash)
# DEEPSEEK_MODEL=deepseek-flash
# If the primary model id is rejected by the API, Buck retries once with this model.
# DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash-vision-exp

# Scanned/image PDFs are read via vision (V4.1 Flash multimodal) by default.
# Set to false to reject image PDFs instead of OCR-ing them.
# VISION_ENABLED=true

# Optional: Supabase for auth + quiz history (see https://supabase.com)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Optional: server port
# PORT=3000
